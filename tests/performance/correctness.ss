(define checks 0)
(define (check x) (set! checks (+ checks 1)) (unless x (error 'performance-tests "check failed" checks)))
(define (reject thunk)
 (check (guard (e [else #t]) (thunk) #f)))
(load "lib/performance/load.ss")
(kl:tc '+)
(reject (lambda () (performance-load (path-build (current-directory) "tests/performance/broken-load"))))
(check (kl:value 'shen.*tc*))
(performance-load (path-build (current-directory) "lib/performance"))
(check (kl:value 'shen.*tc*))
(performance-load (path-build (current-directory) "lib/performance"))
(check (kl:value 'shen.*tc*))
(load "examples/performance/sor/load.ss")
(reject (lambda () (performance-sor-load (path-build (current-directory) "tests/performance/broken-load"))))
(check (kl:value 'shen.*tc*))
(performance-sor-load (path-build (current-directory) "examples/performance/sor"))
(check (kl:value 'shen.*tc*))
(performance-sor-load (path-build (current-directory) "examples/performance/sor"))
(check (kl:value 'shen.*tc*))
(kl:load "tests/performance/typed-caller.shen")
(let ([owner (kl:perf-test.typed-create 9)])
 (check (fl=? 0.0 (kl:perf-test.typed-step owner))))
(reject (lambda () (kl:load "tests/performance/typed-invalid.shen")))
(check (kl:value 'shen.*tc*))
(kl:tc '-)
(performance-load (path-build (current-directory) "lib/performance"))
(check (not (kl:value 'shen.*tc*)))
(performance-sor-load (path-build (current-directory) "examples/performance/sor"))
(check (not (kl:value 'shen.*tc*)))
(parameterize ([optimize-level 3])
 (kl:load "tests/performance/dynamic-sor.shen")
 (kl:load "tests/performance/solve.shen"))
(parameterize ([optimize-level 2]) (load "tests/performance/application.ss"))
(check (fl=? 0.0 (kl:perf.f64 0)))
(check (fl=? 2.0 (kl:perf.f64 2)))
(check (fl=? 9007199254740992.0 (performance-f64 9007199254740992)))
(for-each (lambda (x) (reject (lambda () (performance-f64 x))))
 (list +nan.0 +inf.0 -inf.0 9007199254740993 -9007199254740993 1/2 1+2i))
(for-each (lambda (x) (reject (lambda () (performance-f64-create 1 x))))
 (list +nan.0 +inf.0 -inf.0))
(let ([owner (performance-f64-create 1 -0.0)] [bytes (make-bytevector 8)])
 (bytevector-ieee-double-native-set! bytes 0 (performance-f64-ref owner 0))
 (check (= (bytevector-u64-native-ref bytes 0) #x8000000000000000))
 (performance-load (path-build (current-directory) "lib/performance"))
 (check (= 1 (performance-f64-length owner))))
(let* ([standard (vector 2 1.0 2.0)] [owner (performance-f64-from-vector standard)])
 (check (equal? standard (performance-f64-to-vector owner))))
(reject (lambda () (performance-f64-from-vector (vector 3 1.0 2.0))))
(let ([a (performance-f64-create 25 0.0)] [b (performance-f64-create 25 1.0)])
 (check (flvector? (performance-storage a)))
 (check (= 25 (kl:perf.f64-length a)))
 (let ([before (performance-f64-export a)])
  (for-each (lambda (thunk) (reject thunk) (check (equal? before (performance-f64-export a))))
   (list (lambda () (performance-f64-set! a 1 1))
         (lambda () (performance-f64-set! a -1 1.0))
         (lambda () (performance-f64-set! a 25 1.0))
         (lambda () (performance-f64-set! a 1 +nan.0))
         (lambda () (performance-f64-set! a 1 +inf.0))
         (lambda () (performance-f64-copy! a a))
         (lambda () (performance-f64-copy! a (performance-f64-create 24 0.0)))
         (lambda () (performance-sor-batch-residual a 4 5 10 1.25))
         (lambda () (performance-sor-batch-residual a 5 5 -1 1.25))
         (lambda () (performance-sor-batch-residual a 5 5 10 1.0))
         (lambda () (performance-sor-batch-residual a 5 5 10 1))
         (lambda () (performance-sor-batch-residual a 5.0 5 10 1.25)))))
 (reject (lambda () (performance-f64-import (vector 0.0 1))))
 (reject (lambda () (performance-f64-create 2 0)))
 (check (fl=? 0.0 (performance-sor-batch-residual a 5 5 10 1.25)))
 (performance-f64-copy! a b)
 (check (fl=? 1.0 (performance-f64-ref a 0)))
 (performance-f64-close! a)
 (for-each reject (list (lambda () (performance-f64-ref a 0))
                        (lambda () (performance-f64-length a))
                        (lambda () (performance-f64-copy! b a))
                        (lambda () (performance-sor-batch-residual a 5 5 1 1.25))))
 (performance-f64-close! a) (performance-f64-close! b))
(reject (lambda () (performance-region-form '(unknown binary64))))
(let ([owner (performance-f64-create 9 0.0)] [kernel performance-sor-kernel])
 ;; Execution-failure fault injection checks revocation; it is not numeric
 ;; correctness evidence and does not replace actual full-grid solves below.
 (dynamic-wind
  (lambda () (set! performance-sor-kernel (lambda args +nan.0)))
  (lambda ()
   (reject (lambda () (performance-sor-batch-residual owner 3 3 1 1.25)))
   (reject (lambda () (performance-f64-ref owner 0))))
  (lambda () (set! performance-sor-kernel kernel))))
(for-each
 (lambda (n)
  (let ([reference #f])
   (for-each
    (lambda (mode)
     (let ([result (kl:perf-test.solve mode n n (if (= n 11) 1e-8 1e-5))])
      (unless reference (set! reference result))
      (check (equal? result reference))
      (printf "SOLVE ~s ~s ~s ~s ~s ~s ~s\n" mode n (vector-ref result 0)
       (vector-ref result 1) (vector-ref result 2) (vector-ref result 3) (vector-ref result 4))))
    '(dynamic region typed-control)))) '(11 100))
(printf "PERFORMANCE_CORRECTNESS PASS ~s\n" checks)
