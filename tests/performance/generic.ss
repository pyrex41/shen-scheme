;; Fresh-process generic-only smoke: numerical examples must remain absent.
(define checks 0)
(define (check condition)
 (set! checks (+ checks 1)) (unless condition (error 'generic-test "check failed" checks)))
(define (unbound? symbol)
 (guard (e [else #t]) (eval symbol) #f))
(load "lib/performance/load.ss")
(kl:tc '+)
(performance-load (path-build (current-directory) "lib/performance"))
(check (kl:value 'shen.*tc*))
(let* ([source (kl:perf.f64-new 4 (kl:perf.f64 1))]
       [target (kl:perf.f64-new 4 (kl:perf.f64 0))])
 (kl:perf.f64-copy target source)
 (check (fl=? 1.0 (kl:perf.f64-ref target 3)))
 (performance-load (path-build (current-directory) "lib/performance"))
 (check (= 4 (kl:perf.f64-length source)))
 (kl:perf.f64-close source)
 (check (guard (e [else #t]) (kl:perf.f64-ref source 0) #f)))
(for-each (lambda (symbol) (check (unbound? symbol)))
 '(performance-region-form performance-sor-kernel performance-sor-batch-residual
   performance-sor-load performance-reduction kl:perf.sor-batch-residual))
(check (kl:value 'shen.*tc*))
(kl:tc '-)
(performance-load (path-build (current-directory) "lib/performance"))
(check (not (kl:value 'shen.*tc*)))
(printf "GENERIC_PERFORMANCE PASS ~s\n" checks)
