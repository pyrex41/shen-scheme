;; Managed binary64 owners. This file is loaded by load.ss with its own path.
(define-record-type (performance-array %performance-array performance-array?)
 (fields (mutable storage performance-storage performance-storage-set!)
         (immutable length performance-length)))
(define (performance-live who owner)
 (unless (and (performance-array? owner) (performance-storage owner))
  (error who "expected live managed binary64 array"))
 (performance-storage owner))
(define (performance-count who count)
 (unless (and (fixnum? count) (<= 0 count 1048576))
  (error who "expected exact bounded array length" count)))
(define (performance-binary64 who value)
 (unless (and (flonum? value) (fl=? value value)
              (not (fl=? value +inf.0)) (not (fl=? value -inf.0)))
  (error who "expected explicit finite binary64 value" value)))
(define (performance-f64-create count value)
 (performance-count 'performance-f64-create count)
 (performance-binary64 'performance-f64-create value)
 (%performance-array (make-flvector count value) count))
(define (performance-f64-close! owner)
 (unless (performance-array? owner) (error 'performance-f64-close! "expected array owner"))
 (performance-storage-set! owner #f)
 owner)
(define (performance-f64-length owner)
 (performance-live 'performance-f64-length owner) (performance-length owner))
(define (performance-index who owner index)
 (performance-live who owner)
 (unless (and (fixnum? index) (<= 0 index) (< index (performance-length owner)))
  (error who "array index outside bounds" index)))
(define (performance-f64-ref owner index)
 (performance-index 'performance-f64-ref owner index)
 (flvector-ref (performance-storage owner) index))
(define (performance-f64-set! owner index value)
 (performance-index 'performance-f64-set! owner index)
 (performance-binary64 'performance-f64-set! value)
 (flvector-set! (performance-storage owner) index value) owner)
;; Copy is transactional with respect to argument/type rejection. Distinct live
;; owners are mandatory even for a zero-length copy. Exact length contract.
(define (performance-f64-copy! destination source)
 (let ([dst (performance-live 'performance-f64-copy! destination)]
       [src (performance-live 'performance-f64-copy! source)])
  (when (eq? destination source) (error 'performance-f64-copy! "aliased owners"))
  (unless (= (performance-length destination) (performance-length source))
   (error 'performance-f64-copy! "array length mismatch"))
  (do ([i 0 (fx+ i 1)]) ((fx= i (performance-length source)))
   (flvector-set! dst i (flvector-ref src i)))) destination)
(define (performance-f64-import vector)
 (unless (vector? vector) (error 'performance-f64-import "expected boxed abstract vector"))
 (let ([n (vector-length vector)])
  (performance-count 'performance-f64-import n)
  (do ([i 0 (fx+ i 1)]) ((fx= i n))
   (performance-binary64 'performance-f64-import (vector-ref vector i)))
  (let ([owner (performance-f64-create n 0.0)])
   (do ([i 0 (fx+ i 1)]) ((fx= i n))
    (flvector-set! (performance-storage owner) i (vector-ref vector i))) owner)))
(define (performance-f64-export owner)
 (let* ([src (performance-live 'performance-f64-export owner)] [n (performance-length owner)]
        [out (make-vector n)])
  (do ([i 0 (fx+ i 1)]) ((fx= i n) out)
   (vector-set! out i (flvector-ref src i)))))
;; Explicit conversion: exact integers only within the all-integers-exact
;; binary64 range. No rationals, complex values, overflow, or silent rounding.
(define (performance-f64 value)
 (cond [(flonum? value) (performance-binary64 'performance-f64 value) value]
       [(and (integer? value) (exact? value) (<= -9007199254740992 value 9007199254740992))
        (inexact value)]
       [else (error 'performance-f64 "expected finite flonum or exact integer within 2^53" value)]))
(define (performance-f64-from-vector vector)
 (unless (and (vector? vector) (> (vector-length vector) 0)
              (fixnum? (vector-ref vector 0)) (>= (vector-ref vector 0) 0)
              (= (vector-length vector) (+ (vector-ref vector 0) 1)))
  (error 'performance-f64-from-vector "expected standard Shen vector with length header"))
 (performance-f64-import (vector-copy vector 1 (- (vector-length vector) 1))))
(define (performance-f64-to-vector owner)
 (let* ([n (performance-f64-length owner)] [out (make-vector (+ n 1))])
  (vector-set! out 0 n)
  (do ([i 0 (+ i 1)]) ((= i n) out)
   (vector-set! out (+ i 1) (performance-f64-ref owner i)))))
